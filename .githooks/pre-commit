#!/bin/sh
# Block commits that contain something that looks like an API key.
#   sk-ant-...  Anthropic (Claude API)
#   AIza...     Google (Gemini API / AI Studio)
# The same patterns are checked again on GitHub by .github/workflows/secret-scan.yml.
if git diff --cached -U0 | grep -E '^\+' | grep -E 'sk-ant-[A-Za-z0-9_-]{10,}|AIza[0-9A-Za-z_-]{35}' >/dev/null; then
  echo "pre-commit: staged changes contain an API key (sk-ant-... or AIza...). Commit aborted." >&2
  exit 1
fi
# Block files under private-data/ or secrets/ even if force-added.
if git diff --cached --name-only | grep -E '^(private-data|secrets)/' >/dev/null; then
  echo "pre-commit: private-data/ or secrets/ must not be committed." >&2
  exit 1
fi
exit 0
